# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Aiven MySQL)
# For Aiven MySQL, enter your Service URI details below.
# SSL is enabled by default for remote hosts.
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=20761
DB_NAME=pollify_db
DB_USER=avnadmin
DB_PASS=your_aiven_mysql_password
DB_SSL=true

# Authentication
# Use a strong, random 32+ character string
JWT_SECRET=your_jwt_secret_key_here

# Frontend Integration & CORS
# Set this to your deployed Vercel frontend URL (e.g. https://pollify.vercel.app)
# Multiple origins can be comma-separated
CLIENT_URL=https://your-frontend-domain.vercel.app

# Cloudinary (Image upload storage for avatars and poll images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (OTP verification)
# Option 1: Brevo HTTP API (Recommended on Vercel Serverless - never blocked)
BREVO_API_KEY=your_brevo_api_key_or_smtp_pass
EMAIL_FROM=your-verified-sender@example.com

# Option 2: Resend API (Alternative HTTP email API)
# RESEND_API_KEY=re_your_resend_api_key

# Option 3: Standard SMTP Fallback
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
